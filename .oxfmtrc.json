{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": true,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "bracketSpacing": false,
  "arrowParens": "always",

  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "next-env.d.ts",
    "components/ui/**",
    "hooks/use-mobile.ts"
  ]
}
